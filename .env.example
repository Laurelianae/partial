# SSH hostnames or aliases
# Do not include user@ or a port here.
PARTIAL_NODE_0=your-first-ssh-host
PARTIAL_NODE_1=your-second-ssh-host

# Optional: empty means use id -un (current user).
PARTIAL_USER=

# Relative to the remote user's home directory.
PARTIAL_REMOTE_DIR=Development/Projects/partial

# Used for distributed tests and two-Spark serving.
# Node 0's IP/DNS name, reachable from BOTH remote nodes.
PARTIAL_MASTER_ADDR=
PARTIAL_MASTER_PORT=29500

# Optional per-node transport settings. Use the interfaces from the passing smoke test.
# PARTIAL_NODE_0_NCCL_SOCKET_IFNAME=your-connectx-interface
# PARTIAL_NODE_1_NCCL_SOCKET_IFNAME=your-connectx-interface
# PARTIAL_NODE_0_GLOO_SOCKET_IFNAME=your-connectx-interface
# PARTIAL_NODE_1_GLOO_SOCKET_IFNAME=your-connectx-interface
# PARTIAL_NODE_0_NCCL_IB_HCA=your-rdma-device
# PARTIAL_NODE_1_NCCL_IB_HCA=your-rdma-device
